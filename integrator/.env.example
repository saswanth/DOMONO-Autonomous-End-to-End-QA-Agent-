# Copy this file to .env and fill in real values. Never commit the real .env file.

# --- GitHub (Module 5: PR / commit automation) ---
GITHUB_TOKEN=
GITHUB_OWNER=acme-corp
GITHUB_REPO=helpdesk-app
GITHUB_BASE_BRANCH=main
GITHUB_FEATURE_BRANCH=domono/qa-automation-suite

# --- Mail notifications (PAT-based authentication) ---
# Many providers (GitHub, Azure/Office365, generic SMTP relays) accept a
# Personal Access Token in place of a password for SMTP AUTH LOGIN/PLAIN.
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=domono-bot@example.com
SMTP_PAT=
NOTIFY_EMAIL_TO=qa-team@example.com
NOTIFY_EMAIL_FROM="DOMONO Bot <domono-bot@example.com>"

# --- Pipeline context (normally supplied programmatically) ---
STORY_ID=HELP-142
